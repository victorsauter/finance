{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": ["src/routeTree.gen.ts", ".claude/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // shadcn components export variants next to components, and route files
      // export `Route` next to their component: both are the documented shape.
      "files": ["src/components/ui/**", "src/routes/**"],
      "rules": { "react/only-export-components": "off" }
    }
  ]
}
